{
  "name": "@storybook/test-runner",
  "version": "0.24.0",
  "description": "Test runner for Storybook stories",
  "keywords": [
    "storybook-addons",
    "test",
    "runner",
    "jest",
    "testing-library",
    "playwright"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/storybookjs/test-runner"
  },
  "license": "MIT",
  "author": "shilman",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "test-storybook": "./dist/test-storybook.js"
  },
  "files": [
    "dist",
    "README.md",
    "playwright",
    "jest-preset.json",
    "*.d.ts"
  ],
  "scripts": {
    "build": "tsup",
    "build-storybook": "storybook build",
    "build:watch": "tsup --watch",
    "generate-dynamic-stories": "node scripts/generate-dynamic-stories.js",
    "prepare": "husky",
    "release": "pnpm build && pnpm changeset publish",
    "start": "concurrently \"pnpm run build:watch\" \"pnpm run storybook -- --quiet\"",
    "storybook": "storybook dev -p 6006",
    "test": "vitest",
    "test-storybook": "node dist/test-storybook",
    "test-storybook:ci": "concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"pnpm run build-storybook -- --quiet && npx serve storybook-static -l 6006\" \"wait-on tcp:6006 && pnpm test-storybook\"",
    "test-storybook:ci-coverage": "concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"pnpm run build-storybook -- --quiet && npx serve storybook-static -l 6006\" \"wait-on tcp:6006 && pnpm test-storybook -- --coverage\"",
    "test-storybook:ci-failures": "concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"TEST_FAILURES=1 pnpm run build-storybook -- --quiet && npx serve storybook-static -l 6006\" \"wait-on tcp:6006 && pnpm test-storybook:failures\"",
    "test-storybook:ci-json": "concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"pnpm run build-storybook -- --quiet && npx serve storybook-static -l 6006\" \"wait-on tcp:6006 && SKIP_SNAPSHOTS=true pnpm test-storybook:json\"",
    "test-storybook:failures": "SKIP_SNAPSHOTS=true TEST_FAILURES=1 pnpm test-storybook -- --json --failOnConsole --outputFile test-results.json",
    "test-storybook:json": "pnpm test-storybook -- --stories-json",
    "test-storybook:no-cache": "pnpm test-storybook -- --no-cache",
    "changeset": "changeset",
    "format": "prettier --write ."
  },
  "lint-staged": {
    "*.{ts,js,tsx,jsx,css,md}": "prettier --write"
  },
  "dependencies": {
    "@babel/core": "^7.22.5",
    "@babel/generator": "^7.22.5",
    "@babel/template": "^7.22.5",
    "@babel/types": "^7.22.5",
    "@jest/types": "^30.0.1",
    "@swc/core": "^1.5.22",
    "@swc/jest": "^0.2.38",
    "expect-playwright": "^0.8.0",
    "jest": "^30.0.4",
    "jest-circus": "^30.0.4",
    "jest-environment-node": "^30.0.4",
    "jest-junit": "^16.0.0",
    "jest-process-manager": "^0.4.0",
    "jest-runner": "^30.0.4",
    "jest-serializer-html": "^7.1.0",
    "jest-watch-typeahead": "^3.0.1",
    "nyc": "^15.1.0",
    "playwright": "^1.14.0",
    "playwright-core": ">=1.2.0",
    "rimraf": "^3.0.2",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@babel/cli": "^7.12.1",
    "@babel/preset-env": "^7.19.4",
    "@babel/preset-react": "^7.18.6",
    "@babel/preset-typescript": "^7.18.6",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@storybook/addon-a11y": "^10.0.0",
    "@storybook/addon-coverage": "^1.0.0",
    "@storybook/addon-docs": "^10.0.0",
    "@storybook/react-vite": "^10.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.10",
    "@types/rimraf": "^3.0.2",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "5.30.7",
    "@typescript-eslint/parser": "5.30.7",
    "@vitejs/plugin-react": "^4.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "babel-loader": "^8.1.0",
    "babel-plugin-istanbul": "^6.1.1",
    "can-bind-to-host": "^1.1.1",
    "commander": "^9.0.0",
    "concurrently": "^7.0.0",
    "glob": "^10.2.2",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "jest-circus": "^30.0.0",
    "jest-environment-node": "^30.0.0",
    "jest-image-snapshot": "^6.2.0",
    "jest-runner": "^30.0.0",
    "lint-staged": "^13.0.3",
    "pathe": "^2.0.3",
    "pkg-pr-new": "^0.0.66",
    "pkg-up": "^5.0.0",
    "playwright": ">=1.24.0",
    "playwright-chromium": ">=1.24.0",
    "prettier": "^2.8.1",
    "react": "^17.0.1",
    "react-dom": "^17.0.1",
    "read-pkg-up": "^7.0.1",
    "storybook": "^10.0.0",
    "tempy": "^1.0.1",
    "ts-dedent": "^2.0.0",
    "ts-jest": "^29.4.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.5",
    "vitest": "^3.2.4",
    "wait-on": "^7.2.0"
  },
  "peerDependencies": {
    "storybook": "^0.0.0-0 || ^10.0.0 || ^10.0.0-0 || ^10.1.0-0 || ^10.2.0-0 || ^10.3.0-0 || ^10.4.0-0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "storybook": {
    "displayName": "Storybook test runner",
    "unsupportedFrameworks": [
      "react-native"
    ],
    "icon": "https://user-images.githubusercontent.com/321738/63501763-88dbf600-c4cc-11e9-96cd-94adadc2fd72.png"
  }
}
